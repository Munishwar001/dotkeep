# Copy this file to .env.local and fill in your own values. .env.local is git-ignored: never commit it.

# MongoDB connection string. Local example: mongodb://localhost:27017/
# MongoDB Atlas: Database -> Connect -> Drivers -> copy the URI and replace <password>.
MONGODB_URI=

# Database name. Leave empty to use the one in MONGODB_URI.
MONGODB_DB=dotkeep

# Encrypts every secret value before it is saved (AES-256-GCM). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK IT UP. If it is lost, every stored secret is lost for good. Use the same key on every computer.
VAULT_ENCRYPTION_KEY=

# ---- Email (needed to send the "verify your email" link) ----
# Any SMTP provider works: Gmail (app password), Brevo, Mailgun, Resend's SMTP, ...
# In DEVELOPMENT, if SMTP_HOST is empty the email is printed in the terminal instead, so you can copy the link.
# In PRODUCTION these must be set, otherwise verification emails can't be sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The "From" address, for example:  Dotkeep <no-reply@yourdomain.com>
MAIL_FROM=

# The public address of the site, used to build the link inside emails. Never taken from the request.
# Local example: http://localhost:3000     Production: https://yourdomain.com
APP_URL=http://localhost:3000

# ---- Google sign-in ("Continue with Google") ----
# Optional. Leave both empty and the Google button is hidden.
# 1. https://console.cloud.google.com -> APIs & Services -> Credentials -> Create credentials -> OAuth client ID (Web application)
# 2. Authorized redirect URI:  <APP_URL>/api/auth/google/callback   (local example: http://localhost:3000/api/auth/google/callback)
# 3. Copy the client ID and secret here. Keep the secret private.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
